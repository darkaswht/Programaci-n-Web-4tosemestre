@{
    ViewData["Title"] = "Dashboard";
}

<h4 class="mb-4">Dashboard - Administrador</h4>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-header">Libros</div>
            <div class="card-body">
                <h2 class="text-dark">@ViewBag.TotalLibros</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-header">Usuarios</div>
            <div class="card-body">
                <h2 class="text-dark">@ViewBag.TotalUsuarios</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-header">Prestamos</div>
            <div class="card-body">
                <h2 class="text-dark">@ViewBag.TotalPrestamos</h2>
            </div>
        </div>
    </div>
</div>
