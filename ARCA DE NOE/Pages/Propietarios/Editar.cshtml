@page "{id:int}"
@model ARCA_DE_NOE.Pages.Propietarios.EditarModel
@{
    ViewData["Title"] = "Editar propietario";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none text-muted" style="font-size:.85rem;">
        <i class="bi bi-arrow-left me-1"></i>Volver a propietarios
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-card">
            <div class="card-header-arca d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square" style="color:var(--azul);font-size:1.1rem;"></i>
                <span class="fw-semibold" style="color:var(--azul);">Editar propietario</span>
            </div>
            <div class="p-4">
                <form method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre</label>
                            <input type="text" class="form-control" asp-for="Propietario.Nombre"
                                   maxlength="100" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Apellidos</label>
                            <input type="text" class="form-control" asp-for="Propietario.Apellidos"
                                   maxlength="150" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Teléfono</label>
                            <input type="tel" class="form-control" asp-for="Propietario.Telefono"
                                   maxlength="20" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" asp-for="Propietario.Email"
                                   maxlength="200" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" asp-for="Propietario.Activo" />
                                <label class="form-check-label" style="font-size:.9rem;">Propietario activo</label>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-page="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-arca px-4">
                            <i class="bi bi-check2 me-1"></i>Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
