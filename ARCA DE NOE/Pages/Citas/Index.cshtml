@page
@model ARCA_DE_NOE.Pages.Citas.IndexModel
@using ARCA_DE_NOE.Models
@{
    ViewData["Title"] = "Citas";
}

<div class="d-flex align-items-start justify-content-between mb-4 flex-wrap gap-2">
    <div class="section-header">
        <h2 class="fw-bold mb-0" style="font-size:1.5rem;">Citas</h2>
        <p class="text-muted mb-0 mt-1" style="font-size:.85rem;">Agenda de consultas veterinarias</p>
    </div>
    <a asp-page="Crear" class="btn btn-arca px-4 py-2">
        <i class="bi bi-plus-lg me-1"></i>Nueva cita
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table tabla-arca align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3">Mascota</th>
                        <th>Veterinario</th>
                        <th>Fecha y hora</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Citas)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold" style="font-size:.9rem;">
                                <i class="bi bi-paw me-1" style="color:var(--beige);"></i>@c.NombreMascota
                            </td>
                            <td style="font-size:.88rem;color:var(--muted);">
                                Dr. @c.NombreVeterinario
                            </td>
                            <td style="font-size:.88rem;">
                                <div class="fw-medium">@c.FechaHora.ToString("dd/MM/yyyy")</div>
                                <div class="text-muted" style="font-size:.8rem;">
                                    <i class="bi bi-clock me-1"></i>@c.FechaHora.ToString("HH:mm")
                                </div>
                            </td>
                            <td class="text-muted" style="font-size:.88rem;max-width:180px;">
                                @c.Motivo
                            </td>
                            <td>
                                @switch (c.Estado)
                                {
                                    case EstadoCita.Pendiente:
                                        <span class="badge badge-pendiente rounded-pill px-3 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i>Pendiente
                                        </span>
                                        break;
                                    case EstadoCita.Completada:
                                        <span class="badge badge-completada rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Completada
                                        </span>
                                        break;
                                    case EstadoCita.Cancelada:
                                        <span class="badge badge-cancelada rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle me-1"></i>Cancelada
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-page="Editar" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-arca-outline me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Eliminar" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Citas.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-2 d-block mb-2 opacity-50"></i>
                                No hay citas registradas todavía.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
