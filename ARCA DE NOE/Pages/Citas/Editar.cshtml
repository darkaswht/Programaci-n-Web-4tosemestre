@page "{id:int}"
@model ARCA_DE_NOE.Pages.Citas.EditarModel
@{
    ViewData["Title"] = "Editar cita";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none text-muted" style="font-size:.85rem;">
        <i class="bi bi-arrow-left me-1"></i>Volver a citas
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <div class="card-header-arca d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square" style="color:var(--azul);font-size:1.1rem;"></i>
                <span class="fw-semibold" style="color:var(--azul);">Editar cita</span>
            </div>
            <div class="p-4">
                <form method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Mascota</label>
                            <select class="form-select" asp-for="Cita.NombreMascota">
                                <option>Rocky</option>
                                <option>Mia</option>
                                <option>Toby</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Veterinario</label>
                            <select class="form-select" asp-for="Cita.NombreVeterinario">
                                <option>María Sánchez</option>
                                <option>Jorge Pérez</option>
                                <option>Sofía Díaz</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha y hora</label>
                            <input type="datetime-local" class="form-control" asp-for="Cita.FechaHora" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estado</label>
                            <select class="form-select" asp-for="Cita.Estado">
                                <option value="0">Pendiente</option>
                                <option value="1">Completada</option>
                                <option value="2">Cancelada</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Motivo de la consulta</label>
                            <input type="text" class="form-control" asp-for="Cita.Motivo" maxlength="300" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Diagnóstico</label>
                            <textarea class="form-control" asp-for="Cita.Diagnostico" rows="3"></textarea>
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-page="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-arca px-4">
                            <i class="bi bi-check2 me-1"></i>Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
