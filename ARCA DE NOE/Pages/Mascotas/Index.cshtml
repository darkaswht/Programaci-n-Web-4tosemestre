@page
@model ARCA_DE_NOE.Pages.Mascotas.IndexModel
@{
    ViewData["Title"] = "Mascotas";
}

<div class="d-flex align-items-start justify-content-between mb-4 flex-wrap gap-2">
    <div class="section-header">
        <h2 class="fw-bold mb-0" style="font-size:1.5rem;">Mascotas</h2>
        <p class="text-muted mb-0 mt-1" style="font-size:.85rem;">Pacientes registrados en la clínica</p>
    </div>
    <a asp-page="Crear" class="btn btn-arca px-4 py-2">
        <i class="bi bi-plus-lg me-1"></i>Nueva mascota
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table tabla-arca align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3">Mascota</th>
                        <th>Propietario</th>
                        <th>Especie / Raza</th>
                        <th>Color</th>
                        <th>Nacimiento</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Mascotas)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span style="font-size:1.4rem;line-height:1;">
                                        @(m.Especie == "Perro" ? "🐶" : m.Especie == "Gato" ? "🐱" :
                                          m.Especie == "Ave"   ? "🐦" : m.Especie == "Conejo" ? "🐰" : "🐾")
                                    </span>
                                    <span class="fw-semibold" style="font-size:.93rem;">@m.Nombre</span>
                                </div>
                            </td>
                            <td class="text-muted" style="font-size:.88rem;">@m.NombrePropietario</td>
                            <td style="font-size:.88rem;">
                                <span class="fw-medium">@m.Especie</span>
                                <span class="text-muted"> / @m.Raza</span>
                            </td>
                            <td class="text-muted" style="font-size:.88rem;">@m.Color</td>
                            <td class="text-muted" style="font-size:.88rem;">
                                @m.FechaNacimiento.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @if (m.Activo)
                                {
                                    <span class="badge badge-activo rounded-pill px-3 py-1">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactivo rounded-pill px-3 py-1">Inactivo</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-page="Editar" asp-route-id="@m.Id"
                                   class="btn btn-sm btn-arca-outline me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Eliminar" asp-route-id="@m.Id"
                                   class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Mascotas.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-paw fs-2 d-block mb-2 opacity-50"></i>
                                No hay mascotas registradas todavía.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
