@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero -->
<div class="hero-banner mb-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
    <div>
        <p class="mb-1 text-uppercase fw-semibold" style="color:var(--amarillo);font-size:0.78rem;letter-spacing:.08em;">
            Sistema de gestión
        </p>
        <h1 class="fw-bold mb-1" style="font-size:1.9rem;">Veterinaria Arca de Noé</h1>
        <p class="mb-0" style="color:rgba(255,255,255,.75);font-size:.95rem;">
            Gestiona propietarios, mascotas, veterinarios y citas desde un solo lugar.
        </p>
    </div>
    <a asp-page="/Citas/Crear" class="btn btn-arca px-4 py-2 flex-shrink-0"
       style="background:var(--rojo);white-space:nowrap;">
        <i class="bi bi-plus-circle me-1"></i> Nueva cita
    </a>
</div>

<!-- Tarjetas -->
<div class="row g-3">

    <div class="col-6 col-lg-3">
        <a asp-page="/Propietarios/Index" class="dash-card d-block p-3 p-md-4">
            <div class="icon-wrap mb-3" style="background:#E8EBF7;">
                <i class="bi bi-people" style="color:var(--azul);"></i>
            </div>
            <div class="fw-semibold" style="font-size:.95rem;">Propietarios</div>
            <div class="text-muted" style="font-size:.8rem;">Dueños registrados</div>
        </a>
    </div>

    <div class="col-6 col-lg-3">
        <a asp-page="/Mascotas/Index" class="dash-card d-block p-3 p-md-4">
            <div class="icon-wrap mb-3" style="background:#FDF3E7;">
                <i class="bi bi-paw" style="color:#C4A882;"></i>
            </div>
            <div class="fw-semibold" style="font-size:.95rem;">Mascotas</div>
            <div class="text-muted" style="font-size:.8rem;">Pacientes de la clínica</div>
        </a>
    </div>

    <div class="col-6 col-lg-3">
        <a asp-page="/Veterinarios/Index" class="dash-card d-block p-3 p-md-4">
            <div class="icon-wrap mb-3" style="background:#E8EBF7;">
                <i class="bi bi-person-badge" style="color:var(--azul);"></i>
            </div>
            <div class="fw-semibold" style="font-size:.95rem;">Veterinarios</div>
            <div class="text-muted" style="font-size:.8rem;">Equipo médico</div>
        </a>
    </div>

    <div class="col-6 col-lg-3">
        <a asp-page="/Citas/Index" class="dash-card d-block p-3 p-md-4">
            <div class="icon-wrap mb-3" style="background:#FDECEA;">
                <i class="bi bi-calendar-check" style="color:var(--rojo);"></i>
            </div>
            <div class="fw-semibold" style="font-size:.95rem;">Citas</div>
            <div class="text-muted" style="font-size:.8rem;">Agenda de atenciones</div>
        </a>
    </div>

</div>
