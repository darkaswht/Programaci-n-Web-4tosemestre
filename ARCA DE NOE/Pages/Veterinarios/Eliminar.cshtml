@page "{id:int}"
@model ARCA_DE_NOE.Pages.Veterinarios.EliminarModel
@{
    ViewData["Title"] = "Eliminar veterinario";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none text-muted" style="font-size:.85rem;">
        <i class="bi bi-arrow-left me-1"></i>Volver a veterinarios
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="form-card text-center p-5">
            <div class="delete-icon-wrap mx-auto mb-3">
                <i class="bi bi-person-x-fill fs-2" style="color:var(--rojo);"></i>
            </div>
            <h5 class="fw-bold mb-1">¿Eliminar veterinario?</h5>
            <p class="text-muted mb-4" style="font-size:.9rem;">
                Vas a eliminar al Dr. <strong>@Model.Veterinario.Nombre @Model.Veterinario.Apellidos</strong>.
                Esta acción no se puede deshacer.
            </p>
            <form method="post" class="d-flex gap-2 justify-content-center">
                <a asp-page="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i>Sí, eliminar
                </button>
            </form>
        </div>
    </div>
</div>
