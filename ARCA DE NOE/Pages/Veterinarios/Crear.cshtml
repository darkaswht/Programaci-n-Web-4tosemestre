@page
@model ARCA_DE_NOE.Pages.Veterinarios.CrearModel
@{
    ViewData["Title"] = "Nuevo veterinario";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none text-muted" style="font-size:.85rem;">
        <i class="bi bi-arrow-left me-1"></i>Volver a veterinarios
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-card">
            <div class="card-header-arca d-flex align-items-center gap-2">
                <i class="bi bi-person-badge" style="color:var(--azul);font-size:1.1rem;"></i>
                <span class="fw-semibold" style="color:var(--azul);">Registrar veterinario</span>
            </div>
            <div class="p-4">
                <form method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre</label>
                            <input type="text" class="form-control" asp-for="Veterinario.Nombre"
                                   placeholder="Ej: María" maxlength="100" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Apellidos</label>
                            <input type="text" class="form-control" asp-for="Veterinario.Apellidos"
                                   placeholder="Ej: Sánchez Ramos" maxlength="150" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Especialidad</label>
                            <select class="form-select" asp-for="Veterinario.Especialidad" required>
                                <option value="">— Seleccionar —</option>
                                <option>Medicina General</option>
                                <option>Cirugía</option>
                                <option>Dermatología</option>
                                <option>Cardiología</option>
                                <option>Oftalmología</option>
                                <option>Odontología</option>
                                <option>Nutrición</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Teléfono</label>
                            <input type="tel" class="form-control" asp-for="Veterinario.Telefono"
                                   placeholder="Ej: 555-0101" maxlength="20" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-1">
                                <input class="form-check-input" type="checkbox"
                                       asp-for="Veterinario.Activo" checked />
                                <label class="form-check-label" style="font-size:.9rem;">Veterinario activo</label>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-page="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-arca px-4">
                            <i class="bi bi-check2 me-1"></i>Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
