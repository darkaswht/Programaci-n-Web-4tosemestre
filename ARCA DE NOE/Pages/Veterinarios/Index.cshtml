@page
@model ARCA_DE_NOE.Pages.Veterinarios.IndexModel
@{
    ViewData["Title"] = "Veterinarios";
}

<div class="d-flex align-items-start justify-content-between mb-4 flex-wrap gap-2">
    <div class="section-header">
        <h2 class="fw-bold mb-0" style="font-size:1.5rem;">Veterinarios</h2>
        <p class="text-muted mb-0 mt-1" style="font-size:.85rem;">Equipo médico de la clínica</p>
    </div>
    <a asp-page="Crear" class="btn btn-arca px-4 py-2">
        <i class="bi bi-plus-lg me-1"></i>Nuevo veterinario
    </a>
</div>

<div class="row g-3">
    @foreach (var v in Model.Veterinarios)
    {
        <div class="col-md-6 col-lg-4">
            <div class="vet-card p-4 h-100">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="vet-avatar flex-shrink-0">
                        @v.Nombre[0]@v.Apellidos[0]
                    </div>
                    <div>
                        <div class="fw-semibold" style="font-size:.95rem;">Dr. @v.Nombre @v.Apellidos</div>
                        <div class="text-muted" style="font-size:.82rem;">
                            <i class="bi bi-award me-1"></i>@v.Especialidad
                        </div>
                    </div>
                </div>
                <div class="text-muted mb-3" style="font-size:.85rem;">
                    <i class="bi bi-telephone me-1"></i>@v.Telefono
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    @if (v.Activo)
                    {
                        <span class="badge badge-activo rounded-pill px-3 py-1">Activo</span>
                    }
                    else
                    {
                        <span class="badge badge-inactivo rounded-pill px-3 py-1">Inactivo</span>
                    }
                    <div class="d-flex gap-1">
                        <a asp-page="Editar" asp-route-id="@v.Id"
                           class="btn btn-sm btn-arca-outline" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-page="Eliminar" asp-route-id="@v.Id"
                           class="btn btn-sm btn-outline-danger" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Veterinarios.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-person-badge fs-2 d-block mb-2 opacity-50"></i>
            No hay veterinarios registrados todavía.
        </div>
    }
</div>
